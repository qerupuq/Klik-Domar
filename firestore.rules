rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Receipt validation
    function isValidReceipt(data) {
      return data.userId == request.auth.uid
        && data.storeName is string && data.storeName.size() <= 200
        && data.items is list
        && data.analyzedAt is string
        && data.savedAt == request.time;
    }

    match /receipts/{receiptId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidReceipt(incoming());
      allow update: if false; // Receipts are immutable for now in the app
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
